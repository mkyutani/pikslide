#!/usr/bin/env bash
# Pre-commit guard: blocks a commit whose staged diff contains either
#   1. a term from a personal blocklist (names, employer, internal
#      codenames, etc. -- anything project-specific rules can't predict), or
#   2. text matching a few common secret-like patterns (best-effort, not a
#      substitute for a real secret scanner).
#
# The blocklist lives OUTSIDE this repo (default: ~/.claude/sensitive-terms.txt)
# so the list of sensitive terms itself is never something this repo can leak.
# Override its location with PIKSLIDE_SENSITIVE_TERMS_FILE.
#
# Pattern hits (not blocklist hits) can be exempted via the repo-tracked
# .githooks/allowlist.txt -- for known-legitimate, already-public content
# (e.g. an upstream project's own copyright/attribution email) that would
# otherwise trip the generic patterns on every commit that touches it.
# Override its location with PIKSLIDE_ALLOWLIST_FILE.
#
# Enabled via: git config core.hooksPath .githooks

set -euo pipefail

TERMS_FILE="${PIKSLIDE_SENSITIVE_TERMS_FILE:-$HOME/.claude/sensitive-terms.txt}"
ALLOWLIST_FILE="${PIKSLIDE_ALLOWLIST_FILE:-.githooks/allowlist.txt}"
fail=0

# Only the *added* lines of the staged diff, as actual file content: the
# diff's own "+++ b/..." file-header lines are excluded, and the leading
# '+' marker is stripped so it can't itself feed a pattern match (it is a
# valid email local-part character, for example).
added_lines() {
    git diff --cached --unified=0 --no-color -- . | grep -E '^\+[^+]' | sed 's/^+//' || true
}

# Drop any line matching a fixed string from the allowlist file.
apply_allowlist() {
    local hits="$1"
    if [ -z "$hits" ] || [ ! -f "$ALLOWLIST_FILE" ]; then
        echo "$hits"
        return
    fi
    while IFS= read -r raw_line || [ -n "$raw_line" ]; do
        term="${raw_line%%#*}"
        term="$(echo -n "$term" | xargs)"
        [ -z "$term" ] && continue
        hits="$(echo "$hits" | grep -ivF -- "$term" || true)"
    done < "$ALLOWLIST_FILE"
    echo "$hits"
}

check_pattern() {
    local label="$1" pattern="$2"
    local hits
    hits="$(added_lines | grep -inE -- "$pattern" || true)"
    hits="$(apply_allowlist "$hits")"
    if [ -n "$hits" ]; then
        echo "pre-commit guard: possible $label in staged changes:"
        echo "$hits" | sed 's/^/    /'
        fail=1
    fi
}

check_term() {
    local term="$1"
    local hits
    hits="$(added_lines | grep -inF -- "$term" || true)"
    if [ -n "$hits" ]; then
        echo "pre-commit guard: blocked term '$term' found in staged changes:"
        echo "$hits" | sed 's/^/    /'
        fail=1
    fi
}

# 1) Generic secret-like patterns.
check_pattern "AWS access key"     'AKIA[0-9A-Z]{16}'
check_pattern "PEM private key"    '-----BEGIN [A-Z ]*PRIVATE KEY-----'
check_pattern "GitHub token"       '(ghp|gho|ghu|ghs|ghr)_[A-Za-z0-9]{36}'
check_pattern "Slack token"        'xox[baprs]-[0-9A-Za-z-]{10,}'
check_pattern "email address"      '[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}'

# 2) Personal blocklist (names, employer, internal codenames, ...).
if [ -f "$TERMS_FILE" ]; then
    while IFS= read -r raw_line || [ -n "$raw_line" ]; do
        term="${raw_line%%#*}"                  # strip trailing comment
        term="$(echo -n "$term" | xargs)"        # trim whitespace
        [ -z "$term" ] && continue
        check_term "$term"
    done < "$TERMS_FILE"
fi

if [ "$fail" -ne 0 ]; then
    echo
    echo "Commit blocked by pre-commit guard (.githooks/pre-commit)."
    echo "Remove the matched content, or edit the blocklist at: $TERMS_FILE"
    echo "If this is a genuine false positive: git commit --no-verify"
    exit 1
fi

exit 0
