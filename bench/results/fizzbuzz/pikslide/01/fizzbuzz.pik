// FizzBuzz flowchart
boxwid = 1.1
boxht = 0.42
ovalwid = 1.1
ovalht = 0.42
diamondwid = 1.9
diamondht = 0.72
lineht = 0.38
pwid = 1.95       // width of every print parallelogram
gap = 0.55        // horizontal gap from a diamond to its print
fill = accent1 lighter 80%

down
Start: oval "Start"
arrow
Init: box "i = 1"
arrow
Cond: diamond "i <= 100"
arrow "yes" ljust
D15: diamond "i % 15 == 0"
arrow "no" ljust
D3: diamond "i % 3 == 0"
arrow "no" ljust
D5: diamond "i % 5 == 0"
arrow "no" ljust
PI: shape flowChartInputOutput "print i" width pwid height boxht
arrow
Inc: box "i = i + 1"

// End, to the right of the loop test
End: oval "End" with .w at Cond.e + (gap, 0)
arrow "no" above from Cond.e to End.w

// The three prints, each to the right of its own test
PFB: shape flowChartInputOutput "print \"FizzBuzz\"" width pwid height boxht with .w at D15.e + (gap - pwid/10, 0)
PF: shape flowChartInputOutput "print \"Fizz\"" width pwid height boxht with .w at D3.e + (gap - pwid/10, 0)
PB: shape flowChartInputOutput "print \"Buzz\"" width pwid height boxht with .w at D5.e + (gap - pwid/10, 0)
arrow "yes" above from D15.e to PFB.w + (pwid/10, 0)
arrow "yes" above from D3.e to PF.w + (pwid/10, 0)
arrow "yes" above from D5.e to PB.w + (pwid/10, 0)

// The prints join into one line down the right side, into i = i + 1
xr = PFB.e.x + 0.35
arrow from PFB.e - (pwid/10, 0) to (xr, PFB.y) then to (xr, Inc.y) then to Inc.e
line from PF.e - (pwid/10, 0) to (xr, PF.y)
line from PB.e - (pwid/10, 0) to (xr, PB.y)

// From i = i + 1 round the left side, back into the loop test
xl = D15.w.x - 0.4
arrow from Inc.w to (xl, Inc.y) then to (xl, Cond.y) then to Cond.w
