// FizzBuzz flowchart
gap = 0.32          // length of the arrows down the column
side = 0.7          // length of the "yes" arrows out to the prints
diamondwid = 1.7
diamondht = 0.62

down
Start: oval "Start" fit
arrow down gap
Init: box "i = 1" fit
arrow down gap
Cond: diamond "i <= 100"
arrow down gap "yes" ljust
D15: diamond "i % 15 == 0"
arrow down gap "no" ljust
D3: diamond "i % 3 == 0"
arrow down gap "no" ljust
D5: diamond "i % 5 == 0"
arrow down gap "no" ljust
PI: shape flowChartInputOutput "print i" fit
arrow down gap
Inc: box "i = i + 1" fit

// End, to the right of the loop test
End: oval "End" fit with .w at Cond.e + (side, 0)
arrow from Cond.e to End.w "no" above

// The three prints, each to the right of its test
PFB: shape flowChartInputOutput "print \"FizzBuzz\"" fit with .w at D15.e + (side, 0)
PF: shape flowChartInputOutput "print \"Fizz\"" same as PFB with .w at D3.e + (side, 0)
PB: shape flowChartInputOutput "print \"Buzz\"" same as PFB with .w at D5.e + (side, 0)

// A parallelogram's slanted side, at mid-height, is a tenth of its width in
inset = PFB.wid / 10
arrow from D15.e to (PFB.w.x + inset, D15.y) "yes" above
arrow from D3.e to (PF.w.x + inset, D3.y) "yes" above
arrow from D5.e to (PB.w.x + inset, D5.y) "yes" above

// The prints join into one line down the right side, into i = i + 1
jx = PFB.e.x + 0.35
line from (PFB.e.x - inset, PFB.y) to (jx, PFB.y) then down until even with Inc then left until even with Inc.e ->
line from (PF.e.x - inset, PF.y) to (jx, PF.y)
line from (PB.e.x - inset, PB.y) to (jx, PB.y)

// Round the left side, back to the loop test
lx = D15.w.x - 0.35
arrow from Inc.w left until even with (lx, 0) then up until even with Cond then right until even with Cond.w
