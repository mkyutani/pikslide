# FizzBuzz flowchart
diamondwid = 1.8
diamondht = 0.65
boxwid = 1.0
boxht = 0.4
ovalwid = 0.8
ovalht = 0.4
pwid = 1.6
pht = 0.4
# a parallelogram's slanted side, at mid-height, sits this far in from its box
pin = pht * 0.25 / 2

# main column
down
Start: oval "Start"
arrow 0.3
Init: box "i = 1"
arrow 0.3
Loop: diamond "i <= 100"
arrow 0.45 "yes" ljust
D15: diamond "i % 15 == 0"
arrow 0.45 "no" ljust
D3: diamond "i % 3 == 0"
arrow 0.45 "no" ljust
D5: diamond "i % 5 == 0"
arrow 0.45 "no" ljust
PI: shape parallelogram "print i" width pwid height pht
arrow 0.3
Inc: box "i = i + 1"

# right column
px = D15.e.x + 0.7 + pwid / 2
End: oval "End" at (px, Loop.y)
arrow from Loop.e to End.w "no" above
PFB: shape parallelogram "print \"FizzBuzz\"" width pwid height pht at (px, D15.y)
PF: shape parallelogram "print \"Fizz\"" width pwid height pht at (px, D3.y)
PB: shape parallelogram "print \"Buzz\"" width pwid height pht at (px, D5.y)
arrow from D15.e to PFB.w + (pin, 0) "yes" above
arrow from D3.e to PF.w + (pin, 0) "yes" above
arrow from D5.e to PB.w + (pin, 0) "yes" above

# the prints join into one line down the right side
bus = PFB.e.x + 0.35
arrow from PFB.e - (pin, 0) right until even with (bus, 0) then down until even with Inc then left until even with Inc.e
line from PF.e - (pin, 0) right until even with (bus, 0)
line from PB.e - (pin, 0) right until even with (bus, 0)

# loop back round the left side
back = D15.w.x - 0.4
arrow from Inc.w left until even with (back, 0) then up until even with Loop then right until even with Loop.w
