# figures.pik: macros for diagrams whose shape is the point, bundled with
# pikslide (pikslide --help figures). Generated by scripts/gen_figures.py.
#
#     include "figures.pik"
#     P: cycle4("Plan", "Do", "Check", "Act")
#
# Each macro draws a block whose parts are named in it: P.S1, ... and P.C.
# Each part's argument is its strings and attributes, written last, so
# that they win: "Check" bold fill emphasis lighter 60%. figwid and fight
# are the size the figure fits; assign them after the include to change it.

figwid = 6
fight = 3.5

#: cycle3 cycle4 cycle5 cycle6 | steps round a circle, each joined to the next by an arrow
#: P: cycle4(STEP, STEP, STEP, STEP)
#: Three to six steps, the first at the top and the rest clockwise, each an
#: arrow from the one before: PDCA, a feedback loop. Each STEP is its box's
#: strings and attributes. The parts: S1 ... the steps, and C, the center,
#: for a word in the middle.
#: EXAMPLE
#: include "figures.pik"
#: P: cycle4("Plan", "Do", "Check" fill emphasis lighter 60%, "Act")
#: text "Improve" bold at P.C
define cycle3 {
  [
    C: (0, 0)
    S1: box wid figwid*0.3 ht fight*0.17 rad 0.06 fill primary lighter 80% stroke primary $1 at (figwid*0.35*cos(90), fight*0.415*sin(90))
    S2: box wid figwid*0.3 ht fight*0.17 rad 0.06 fill primary lighter 80% stroke primary $2 at (figwid*0.35*cos(-30), fight*0.415*sin(-30))
    S3: box wid figwid*0.3 ht fight*0.17 rad 0.06 fill primary lighter 80% stroke primary $3 at (figwid*0.35*cos(-150), fight*0.415*sin(-150))
    spline -> from (figwid*0.1584, fight*0.3701) to (figwid*0.2094, fight*0.3326) then to (figwid*0.2542, fight*0.2853) then to (figwid*0.2916, fight*0.2296) then to (figwid*0.3204, fight*0.1671) then to (figwid*0.3397, fight*0.0998) then to (figwid*0.3491, fight*0.0295) then to (figwid*0.3482, fight*-0.0417) then to (figwid*0.3371, fight*-0.1116) stroke primary
    spline -> from (figwid*0.2414, fight*-0.3005) to (figwid*0.1953, fight*-0.3444) then to (figwid*0.1436, fight*-0.3785) then to (figwid*0.0878, fight*-0.4017) then to (figwid*0.0296, fight*-0.4135) then to (figwid*-0.0296, fight*-0.4135) then to (figwid*-0.0878, fight*-0.4017) then to (figwid*-0.1436, fight*-0.3785) then to (figwid*-0.1953, fight*-0.3444) then to (figwid*-0.2414, fight*-0.3005) stroke primary
    spline -> from (figwid*-0.3371, fight*-0.1116) to (figwid*-0.3482, fight*-0.0417) then to (figwid*-0.3491, fight*0.0295) then to (figwid*-0.3397, fight*0.0998) then to (figwid*-0.3204, fight*0.1671) then to (figwid*-0.2916, fight*0.2296) then to (figwid*-0.2542, fight*0.2853) then to (figwid*-0.2094, fight*0.3326) then to (figwid*-0.1584, fight*0.3701) stroke primary
  ]
}
define cycle4 {
  [
    C: (0, 0)
    S1: box wid figwid*0.3 ht fight*0.17 rad 0.06 fill primary lighter 80% stroke primary $1 at (figwid*0.35*cos(90), fight*0.415*sin(90))
    S2: box wid figwid*0.3 ht fight*0.17 rad 0.06 fill primary lighter 80% stroke primary $2 at (figwid*0.35*cos(0), fight*0.415*sin(0))
    S3: box wid figwid*0.3 ht fight*0.17 rad 0.06 fill primary lighter 80% stroke primary $3 at (figwid*0.35*cos(-90), fight*0.415*sin(-90))
    S4: box wid figwid*0.3 ht fight*0.17 rad 0.06 fill primary lighter 80% stroke primary $4 at (figwid*0.35*cos(-180), fight*0.415*sin(-180))
    spline -> from (figwid*0.1584, fight*0.3701) to (figwid*0.2099, fight*0.3321) then to (figwid*0.2551, fight*0.2842) then to (figwid*0.2926, fight*0.2277) then to (figwid*0.3214, fight*0.1644) then to (figwid*0.3405, fight*0.0962) stroke primary
    spline -> from (figwid*0.3405, fight*-0.0962) to (figwid*0.3214, fight*-0.1644) then to (figwid*0.2926, fight*-0.2277) then to (figwid*0.2551, fight*-0.2842) then to (figwid*0.2099, fight*-0.3321) then to (figwid*0.1584, fight*-0.3701) stroke primary
    spline -> from (figwid*-0.1584, fight*-0.3701) to (figwid*-0.2099, fight*-0.3321) then to (figwid*-0.2551, fight*-0.2842) then to (figwid*-0.2926, fight*-0.2277) then to (figwid*-0.3214, fight*-0.1644) then to (figwid*-0.3405, fight*-0.0962) stroke primary
    spline -> from (figwid*-0.3405, fight*0.0962) to (figwid*-0.3214, fight*0.1644) then to (figwid*-0.2926, fight*0.2277) then to (figwid*-0.2551, fight*0.2842) then to (figwid*-0.2099, fight*0.3321) then to (figwid*-0.1584, fight*0.3701) stroke primary
  ]
}
define cycle5 {
  [
    C: (0, 0)
    S1: box wid figwid*0.26 ht fight*0.17 rad 0.06 fill primary lighter 80% stroke primary $1 at (figwid*0.37*cos(90), fight*0.415*sin(90))
    S2: box wid figwid*0.26 ht fight*0.17 rad 0.06 fill primary lighter 80% stroke primary $2 at (figwid*0.37*cos(18), fight*0.415*sin(18))
    S3: box wid figwid*0.26 ht fight*0.17 rad 0.06 fill primary lighter 80% stroke primary $3 at (figwid*0.37*cos(-54), fight*0.415*sin(-54))
    S4: box wid figwid*0.26 ht fight*0.17 rad 0.06 fill primary lighter 80% stroke primary $4 at (figwid*0.37*cos(-126), fight*0.415*sin(-126))
    S5: box wid figwid*0.26 ht fight*0.17 rad 0.06 fill primary lighter 80% stroke primary $5 at (figwid*0.37*cos(-198), fight*0.415*sin(-198))
    spline -> from (figwid*0.1392, fight*0.3845) to (figwid*0.1903, fight*0.3559) then to (figwid*0.2368, fight*0.3188) then to (figwid*0.2778, fight*0.2742) then to (figwid*0.3121, fight*0.223) stroke primary
    spline -> from (figwid*0.3689, fight*0.0318) to (figwid*0.3682, fight*-0.0405) then to (figwid*0.3564, fight*-0.1116) then to (figwid*0.3337, fight*-0.1793) then to (figwid*0.3008, fight*-0.2416) stroke primary
    spline -> from (figwid*0.0776, fight*-0.4058) to (figwid*0, fight*-0.415) then to (figwid*-0.0776, fight*-0.4058) stroke primary
    spline -> from (figwid*-0.3008, fight*-0.2416) to (figwid*-0.3337, fight*-0.1793) then to (figwid*-0.3564, fight*-0.1116) then to (figwid*-0.3682, fight*-0.0405) then to (figwid*-0.3689, fight*0.0318) stroke primary
    spline -> from (figwid*-0.3121, fight*0.223) to (figwid*-0.2778, fight*0.2742) then to (figwid*-0.2368, fight*0.3188) then to (figwid*-0.1903, fight*0.3559) then to (figwid*-0.1392, fight*0.3845) stroke primary
  ]
}
define cycle6 {
  [
    C: (0, 0)
    S1: box wid figwid*0.26 ht fight*0.17 rad 0.06 fill primary lighter 80% stroke primary $1 at (figwid*0.37*cos(90), fight*0.415*sin(90))
    S2: box wid figwid*0.26 ht fight*0.17 rad 0.06 fill primary lighter 80% stroke primary $2 at (figwid*0.37*cos(30), fight*0.415*sin(30))
    S3: box wid figwid*0.26 ht fight*0.17 rad 0.06 fill primary lighter 80% stroke primary $3 at (figwid*0.37*cos(-30), fight*0.415*sin(-30))
    S4: box wid figwid*0.26 ht fight*0.17 rad 0.06 fill primary lighter 80% stroke primary $4 at (figwid*0.37*cos(-90), fight*0.415*sin(-90))
    S5: box wid figwid*0.26 ht fight*0.17 rad 0.06 fill primary lighter 80% stroke primary $5 at (figwid*0.37*cos(-150), fight*0.415*sin(-150))
    S6: box wid figwid*0.26 ht fight*0.17 rad 0.06 fill primary lighter 80% stroke primary $6 at (figwid*0.37*cos(-210), fight*0.415*sin(-210))
    spline -> from (figwid*0.1392, fight*0.3845) to (figwid*0.2007, fight*0.3486) then to (figwid*0.2552, fight*0.3005) stroke primary
    spline -> from (figwid*0.3564, fight*0.1116) to (figwid*0.3685, fight*0.0376) then to (figwid*0.3685, fight*-0.0376) then to (figwid*0.3564, fight*-0.1116) stroke primary
    spline -> from (figwid*0.2552, fight*-0.3005) to (figwid*0.2007, fight*-0.3486) then to (figwid*0.1392, fight*-0.3845) stroke primary
    spline -> from (figwid*-0.1392, fight*-0.3845) to (figwid*-0.2007, fight*-0.3486) then to (figwid*-0.2552, fight*-0.3005) stroke primary
    spline -> from (figwid*-0.3564, fight*-0.1116) to (figwid*-0.3685, fight*-0.0376) then to (figwid*-0.3685, fight*0.0376) then to (figwid*-0.3564, fight*0.1116) stroke primary
    spline -> from (figwid*-0.2552, fight*0.3005) to (figwid*-0.2007, fight*0.3486) then to (figwid*-0.1392, fight*0.3845) stroke primary
  ]
}

#: chevron3 chevron4 chevron5 chevron6 | stages in a row of chevrons, left to right
#: P: chevron4(STAGE, STAGE, STAGE, STAGE)
#: Three to six stages, the first a pentagon and the rest chevrons, each
#: fitting into the one before, as wide as figwid together and a fifth of
#: fight high. Each STAGE is its shape's strings and attributes. The parts:
#: S1 ... the stages.
#: EXAMPLE
#: include "figures.pik"
#: P: chevron4("Plan", "Build", "Test", "Launch" fill emphasis lighter 60%)
define chevron3 {
  [
    S1: shape homePlate wid (figwid + 2*(fight*0.072 - 0.04))/3 ht fight*0.2 adjust head.length fight*0.072 fill primary lighter 80% stroke primary $1 with .w at (-figwid/2, 0)
    S2: shape chevron wid (figwid + 2*(fight*0.072 - 0.04))/3 ht fight*0.2 adjust head.length fight*0.072 fill primary lighter 80% stroke primary behind S1 $2 with .w at S1.e - (fight*0.072 - 0.04, 0)
    S3: shape chevron wid (figwid + 2*(fight*0.072 - 0.04))/3 ht fight*0.2 adjust head.length fight*0.072 fill primary lighter 80% stroke primary behind S2 $3 with .w at S2.e - (fight*0.072 - 0.04, 0)
  ]
}
define chevron4 {
  [
    S1: shape homePlate wid (figwid + 3*(fight*0.072 - 0.04))/4 ht fight*0.2 adjust head.length fight*0.072 fill primary lighter 80% stroke primary $1 with .w at (-figwid/2, 0)
    S2: shape chevron wid (figwid + 3*(fight*0.072 - 0.04))/4 ht fight*0.2 adjust head.length fight*0.072 fill primary lighter 80% stroke primary behind S1 $2 with .w at S1.e - (fight*0.072 - 0.04, 0)
    S3: shape chevron wid (figwid + 3*(fight*0.072 - 0.04))/4 ht fight*0.2 adjust head.length fight*0.072 fill primary lighter 80% stroke primary behind S2 $3 with .w at S2.e - (fight*0.072 - 0.04, 0)
    S4: shape chevron wid (figwid + 3*(fight*0.072 - 0.04))/4 ht fight*0.2 adjust head.length fight*0.072 fill primary lighter 80% stroke primary behind S3 $4 with .w at S3.e - (fight*0.072 - 0.04, 0)
  ]
}
define chevron5 {
  [
    S1: shape homePlate wid (figwid + 4*(fight*0.072 - 0.04))/5 ht fight*0.2 adjust head.length fight*0.072 fill primary lighter 80% stroke primary $1 with .w at (-figwid/2, 0)
    S2: shape chevron wid (figwid + 4*(fight*0.072 - 0.04))/5 ht fight*0.2 adjust head.length fight*0.072 fill primary lighter 80% stroke primary behind S1 $2 with .w at S1.e - (fight*0.072 - 0.04, 0)
    S3: shape chevron wid (figwid + 4*(fight*0.072 - 0.04))/5 ht fight*0.2 adjust head.length fight*0.072 fill primary lighter 80% stroke primary behind S2 $3 with .w at S2.e - (fight*0.072 - 0.04, 0)
    S4: shape chevron wid (figwid + 4*(fight*0.072 - 0.04))/5 ht fight*0.2 adjust head.length fight*0.072 fill primary lighter 80% stroke primary behind S3 $4 with .w at S3.e - (fight*0.072 - 0.04, 0)
    S5: shape chevron wid (figwid + 4*(fight*0.072 - 0.04))/5 ht fight*0.2 adjust head.length fight*0.072 fill primary lighter 80% stroke primary behind S4 $5 with .w at S4.e - (fight*0.072 - 0.04, 0)
  ]
}
define chevron6 {
  [
    S1: shape homePlate wid (figwid + 5*(fight*0.072 - 0.04))/6 ht fight*0.2 adjust head.length fight*0.072 fill primary lighter 80% stroke primary $1 with .w at (-figwid/2, 0)
    S2: shape chevron wid (figwid + 5*(fight*0.072 - 0.04))/6 ht fight*0.2 adjust head.length fight*0.072 fill primary lighter 80% stroke primary behind S1 $2 with .w at S1.e - (fight*0.072 - 0.04, 0)
    S3: shape chevron wid (figwid + 5*(fight*0.072 - 0.04))/6 ht fight*0.2 adjust head.length fight*0.072 fill primary lighter 80% stroke primary behind S2 $3 with .w at S2.e - (fight*0.072 - 0.04, 0)
    S4: shape chevron wid (figwid + 5*(fight*0.072 - 0.04))/6 ht fight*0.2 adjust head.length fight*0.072 fill primary lighter 80% stroke primary behind S3 $4 with .w at S3.e - (fight*0.072 - 0.04, 0)
    S5: shape chevron wid (figwid + 5*(fight*0.072 - 0.04))/6 ht fight*0.2 adjust head.length fight*0.072 fill primary lighter 80% stroke primary behind S4 $5 with .w at S4.e - (fight*0.072 - 0.04, 0)
    S6: shape chevron wid (figwid + 5*(fight*0.072 - 0.04))/6 ht fight*0.2 adjust head.length fight*0.072 fill primary lighter 80% stroke primary behind S5 $6 with .w at S5.e - (fight*0.072 - 0.04, 0)
  ]
}

#: pyramid3 pyramid4 pyramid5 | tiers of a pyramid, top to bottom
#: P: pyramid3(TIER, TIER, TIER)
#: Three to five tiers of one triangle figwid wide at its base and fight
#: high, the top tier a triangle and the rest trapezoids: a hierarchy, a
#: mission, vision and values. The top tier is narrow: give it a word. Each
#: TIER is its shape's strings and attributes. The parts: S1 ... the tiers,
#: from the top.
#: EXAMPLE
#: include "figures.pik"
#: P: pyramid3("Mission", "Vision", "Values")
define pyramid3 {
  [
    S1: shape triangle wid figwid*(fight - 0.08)/3/fight ht (fight - 0.08)/3 fill primary lighter 80% stroke primary $1 at (0, fight/2 - (fight - 0.08)/3/2)
    S2: shape trapezoid wid figwid*(1*(fight + 0.04)/3 + (fight - 0.08)/3)/fight ht (fight - 0.08)/3 adjust adj figwid*(fight - 0.08)/3/(2*fight)*100000/min(figwid*(1*(fight + 0.04)/3 + (fight - 0.08)/3)/fight, (fight - 0.08)/3) fill primary lighter 80% stroke primary $2 at (0, fight/2 - 1*(fight + 0.04)/3 - (fight - 0.08)/3/2)
    S3: shape trapezoid wid figwid*(2*(fight + 0.04)/3 + (fight - 0.08)/3)/fight ht (fight - 0.08)/3 adjust adj figwid*(fight - 0.08)/3/(2*fight)*100000/min(figwid*(2*(fight + 0.04)/3 + (fight - 0.08)/3)/fight, (fight - 0.08)/3) fill primary lighter 80% stroke primary $3 at (0, fight/2 - 2*(fight + 0.04)/3 - (fight - 0.08)/3/2)
  ]
}
define pyramid4 {
  [
    S1: shape triangle wid figwid*(fight - 0.12)/4/fight ht (fight - 0.12)/4 fill primary lighter 80% stroke primary $1 at (0, fight/2 - (fight - 0.12)/4/2)
    S2: shape trapezoid wid figwid*(1*(fight + 0.04)/4 + (fight - 0.12)/4)/fight ht (fight - 0.12)/4 adjust adj figwid*(fight - 0.12)/4/(2*fight)*100000/min(figwid*(1*(fight + 0.04)/4 + (fight - 0.12)/4)/fight, (fight - 0.12)/4) fill primary lighter 80% stroke primary $2 at (0, fight/2 - 1*(fight + 0.04)/4 - (fight - 0.12)/4/2)
    S3: shape trapezoid wid figwid*(2*(fight + 0.04)/4 + (fight - 0.12)/4)/fight ht (fight - 0.12)/4 adjust adj figwid*(fight - 0.12)/4/(2*fight)*100000/min(figwid*(2*(fight + 0.04)/4 + (fight - 0.12)/4)/fight, (fight - 0.12)/4) fill primary lighter 80% stroke primary $3 at (0, fight/2 - 2*(fight + 0.04)/4 - (fight - 0.12)/4/2)
    S4: shape trapezoid wid figwid*(3*(fight + 0.04)/4 + (fight - 0.12)/4)/fight ht (fight - 0.12)/4 adjust adj figwid*(fight - 0.12)/4/(2*fight)*100000/min(figwid*(3*(fight + 0.04)/4 + (fight - 0.12)/4)/fight, (fight - 0.12)/4) fill primary lighter 80% stroke primary $4 at (0, fight/2 - 3*(fight + 0.04)/4 - (fight - 0.12)/4/2)
  ]
}
define pyramid5 {
  [
    S1: shape triangle wid figwid*(fight - 0.16)/5/fight ht (fight - 0.16)/5 fill primary lighter 80% stroke primary $1 at (0, fight/2 - (fight - 0.16)/5/2)
    S2: shape trapezoid wid figwid*(1*(fight + 0.04)/5 + (fight - 0.16)/5)/fight ht (fight - 0.16)/5 adjust adj figwid*(fight - 0.16)/5/(2*fight)*100000/min(figwid*(1*(fight + 0.04)/5 + (fight - 0.16)/5)/fight, (fight - 0.16)/5) fill primary lighter 80% stroke primary $2 at (0, fight/2 - 1*(fight + 0.04)/5 - (fight - 0.16)/5/2)
    S3: shape trapezoid wid figwid*(2*(fight + 0.04)/5 + (fight - 0.16)/5)/fight ht (fight - 0.16)/5 adjust adj figwid*(fight - 0.16)/5/(2*fight)*100000/min(figwid*(2*(fight + 0.04)/5 + (fight - 0.16)/5)/fight, (fight - 0.16)/5) fill primary lighter 80% stroke primary $3 at (0, fight/2 - 2*(fight + 0.04)/5 - (fight - 0.16)/5/2)
    S4: shape trapezoid wid figwid*(3*(fight + 0.04)/5 + (fight - 0.16)/5)/fight ht (fight - 0.16)/5 adjust adj figwid*(fight - 0.16)/5/(2*fight)*100000/min(figwid*(3*(fight + 0.04)/5 + (fight - 0.16)/5)/fight, (fight - 0.16)/5) fill primary lighter 80% stroke primary $4 at (0, fight/2 - 3*(fight + 0.04)/5 - (fight - 0.16)/5/2)
    S5: shape trapezoid wid figwid*(4*(fight + 0.04)/5 + (fight - 0.16)/5)/fight ht (fight - 0.16)/5 adjust adj figwid*(fight - 0.16)/5/(2*fight)*100000/min(figwid*(4*(fight + 0.04)/5 + (fight - 0.16)/5)/fight, (fight - 0.16)/5) fill primary lighter 80% stroke primary $5 at (0, fight/2 - 4*(fight + 0.04)/5 - (fight - 0.16)/5/2)
  ]
}

#: funnel3 funnel4 funnel5 | stages of a funnel, top to bottom
#: P: funnel4(STAGE, STAGE, STAGE, STAGE)
#: Three to five stages, each a box narrower than the one above, centered,
#: from figwid wide at the top to four tenths of it at the bottom, fight
#: high together. Each STAGE is its box's strings and attributes. The
#: parts: S1 ... the stages, from the top.
#: EXAMPLE
#: include "figures.pik"
#: P: funnel4("Visitors", "Leads", "Trials", "Customers" bold)
define funnel3 {
  [
    S1: box wid figwid*1 ht (fight - 0.08)/3 fill primary lighter 80% stroke primary $1 at (0, fight/2 - (fight - 0.08)/3/2)
    S2: box wid figwid*0.7 ht (fight - 0.08)/3 fill primary lighter 80% stroke primary $2 at (0, fight/2 - 1*(fight + 0.04)/3 - (fight - 0.08)/3/2)
    S3: box wid figwid*0.4 ht (fight - 0.08)/3 fill primary lighter 80% stroke primary $3 at (0, fight/2 - 2*(fight + 0.04)/3 - (fight - 0.08)/3/2)
  ]
}
define funnel4 {
  [
    S1: box wid figwid*1 ht (fight - 0.12)/4 fill primary lighter 80% stroke primary $1 at (0, fight/2 - (fight - 0.12)/4/2)
    S2: box wid figwid*0.8 ht (fight - 0.12)/4 fill primary lighter 80% stroke primary $2 at (0, fight/2 - 1*(fight + 0.04)/4 - (fight - 0.12)/4/2)
    S3: box wid figwid*0.6 ht (fight - 0.12)/4 fill primary lighter 80% stroke primary $3 at (0, fight/2 - 2*(fight + 0.04)/4 - (fight - 0.12)/4/2)
    S4: box wid figwid*0.4 ht (fight - 0.12)/4 fill primary lighter 80% stroke primary $4 at (0, fight/2 - 3*(fight + 0.04)/4 - (fight - 0.12)/4/2)
  ]
}
define funnel5 {
  [
    S1: box wid figwid*1 ht (fight - 0.16)/5 fill primary lighter 80% stroke primary $1 at (0, fight/2 - (fight - 0.16)/5/2)
    S2: box wid figwid*0.85 ht (fight - 0.16)/5 fill primary lighter 80% stroke primary $2 at (0, fight/2 - 1*(fight + 0.04)/5 - (fight - 0.16)/5/2)
    S3: box wid figwid*0.7 ht (fight - 0.16)/5 fill primary lighter 80% stroke primary $3 at (0, fight/2 - 2*(fight + 0.04)/5 - (fight - 0.16)/5/2)
    S4: box wid figwid*0.55 ht (fight - 0.16)/5 fill primary lighter 80% stroke primary $4 at (0, fight/2 - 3*(fight + 0.04)/5 - (fight - 0.16)/5/2)
    S5: box wid figwid*0.4 ht (fight - 0.16)/5 fill primary lighter 80% stroke primary $5 at (0, fight/2 - 4*(fight + 0.04)/5 - (fight - 0.16)/5/2)
  ]
}

#: venn2 venn3 | two or three overlapping circles, with a word where they all overlap
#: P: venn3(NAME, NAME, NAME, OVERLAP)
#: Two circles side by side, or three in a triangle, the first at the left
#: (top left), as big as figwid and fight allow. Each NAME is a text's
#: strings and attributes, in its circle's own part; OVERLAP is the text
#: where all of them overlap. The parts: S1 ... the circles, T1 ... their
#: names, and C, the overlap's text.
#: EXAMPLE
#: include "figures.pik"
#: P: venn3("Will", "Can", "Must", "Calling" bold)
define venn2 {
  [
    S1: circle diameter min(fight, figwid*0.6) stroke primary at (min(fight, figwid*0.6)*-0.3, min(fight, figwid*0.6)*0)
    S2: circle diameter min(fight, figwid*0.6) stroke primary behind S1 at (min(fight, figwid*0.6)*0.3, min(fight, figwid*0.6)*0)
    T1: text $1 at (min(fight, figwid*0.6)*-0.5, min(fight, figwid*0.6)*0)
    T2: text $2 at (min(fight, figwid*0.6)*0.5, min(fight, figwid*0.6)*0)
    C: text $3 at (0, 0)
  ]
}
define venn3 {
  [
    S1: circle diameter min(fight*0.65, figwid*0.4) stroke primary at (min(fight*0.65, figwid*0.4)*-0.2511, min(fight*0.65, figwid*0.4)*0.145)
    S2: circle diameter min(fight*0.65, figwid*0.4) stroke primary behind S1 at (min(fight*0.65, figwid*0.4)*0.2511, min(fight*0.65, figwid*0.4)*0.145)
    S3: circle diameter min(fight*0.65, figwid*0.4) stroke primary behind S2 at (min(fight*0.65, figwid*0.4)*0, min(fight*0.65, figwid*0.4)*-0.29)
    T1: text $1 at (min(fight*0.65, figwid*0.4)*-0.433, min(fight*0.65, figwid*0.4)*0.25)
    T2: text $2 at (min(fight*0.65, figwid*0.4)*0.433, min(fight*0.65, figwid*0.4)*0.25)
    T3: text $3 at (min(fight*0.65, figwid*0.4)*0, min(fight*0.65, figwid*0.4)*-0.5)
    C: text $4 at (0, 0)
  ]
}

#: matrix2 | a two-by-two matrix, with words at the ends of its axes
#: P: matrix2(TOPLEFT, TOPRIGHT, BOTTOMLEFT, BOTTOMRIGHT, LEFT, RIGHT, BOTTOM, TOP)
#: Four boxes in two rows, figwid by fight together, and the axes' words
#: outside them: LEFT and RIGHT at the ends of the horizontal one, BOTTOM
#: and TOP of the vertical one. Leave an axis's words out ("") and it has
#: none. Each argument is its box's or text's strings and attributes. The
#: parts: S1 ... S4 the boxes, in reading order, and L, R, B, T the words.
#: EXAMPLE
#: include "figures.pik"
#: P: matrix2("Strengths", "Weaknesses", "Opportunities", "Threats", "", "", "External", "Internal")
define matrix2 {
  [
    S1: box wid (figwid - 0.04)/2 ht (fight - 0.04)/2 fill primary lighter 80% stroke primary $1 at (-(figwid + 0.04)/4, (fight + 0.04)/4)
    S2: box wid (figwid - 0.04)/2 ht (fight - 0.04)/2 fill primary lighter 80% stroke primary $2 at ((figwid + 0.04)/4, (fight + 0.04)/4)
    S3: box wid (figwid - 0.04)/2 ht (fight - 0.04)/2 fill primary lighter 80% stroke primary $3 at (-(figwid + 0.04)/4, -(fight + 0.04)/4)
    S4: box wid (figwid - 0.04)/2 ht (fight - 0.04)/2 fill primary lighter 80% stroke primary $4 at ((figwid + 0.04)/4, -(fight + 0.04)/4)
    L: text $5 with .e at (-figwid/2 - 0.08, 0)
    R: text $6 with .w at (figwid/2 + 0.08, 0)
    B: text $7 with .n at (0, -fight/2 - 0.08)
    T: text $8 with .s at (0, fight/2 + 0.08)
  ]
}

#: hub3 hub4 hub5 hub6 hub7 hub8 | a center joined to the items round it
#: P: hub4(CENTER, ITEM, ITEM, ITEM, ITEM)
#: A circle in the center, and three to eight items round it, the first at
#: the top and the rest clockwise, each joined to it by a line. CENTER is
#: the circle's strings and attributes, and each ITEM its box's. The parts:
#: C, the center, and S1 ... the items.
#: EXAMPLE
#: include "figures.pik"
#: P: hub4("Customer" bold, "Sales", "Support", "Product", "Marketing")
define hub3 {
  [
    C: circle diameter fight*0.36 fill primary lighter 60% stroke primary $1 at (0, 0)
    S1: box wid figwid*0.24 ht fight*0.16 rad 0.06 fill primary lighter 80% stroke primary $2 at (figwid*0.38*cos(90), fight*0.42*sin(90))
    S2: box wid figwid*0.24 ht fight*0.16 rad 0.06 fill primary lighter 80% stroke primary $3 at (figwid*0.38*cos(-30), fight*0.42*sin(-30))
    S3: box wid figwid*0.24 ht fight*0.16 rad 0.06 fill primary lighter 80% stroke primary $4 at (figwid*0.38*cos(-150), fight*0.42*sin(-150))
    line from C to S1 chop stroke primary
    line from C to S2 chop stroke primary
    line from C to S3 chop stroke primary
  ]
}
define hub4 {
  [
    C: circle diameter fight*0.36 fill primary lighter 60% stroke primary $1 at (0, 0)
    S1: box wid figwid*0.24 ht fight*0.16 rad 0.06 fill primary lighter 80% stroke primary $2 at (figwid*0.38*cos(90), fight*0.42*sin(90))
    S2: box wid figwid*0.24 ht fight*0.16 rad 0.06 fill primary lighter 80% stroke primary $3 at (figwid*0.38*cos(0), fight*0.42*sin(0))
    S3: box wid figwid*0.24 ht fight*0.16 rad 0.06 fill primary lighter 80% stroke primary $4 at (figwid*0.38*cos(-90), fight*0.42*sin(-90))
    S4: box wid figwid*0.24 ht fight*0.16 rad 0.06 fill primary lighter 80% stroke primary $5 at (figwid*0.38*cos(-180), fight*0.42*sin(-180))
