# --- Theme colours (docs/spec.md SS3.3) --------------------------------
# `theme "slot"` names an OOXML schemeClr slot directly; these give the
# slots friendlier, pikchr-flavoured names. Kept symbolic (never resolved
# to RGB here), so a diagram using them restyles when the theme does.

accent1 = theme "accent1"
accent2 = theme "accent2"
accent3 = theme "accent3"
accent4 = theme "accent4"
accent5 = theme "accent5"
accent6 = theme "accent6"
text1 = theme "tx1"
text2 = theme "tx2"
bg1 = theme "bg1"
bg2 = theme "bg2"
link = theme "hlink"
followed = theme "folHlink"

# --- Built-in defaults ---------------------------------------------------
# Transcribed from pikchr's own aBuiltin[] table (pikchr.y): default
# object sizes and drawing style, all in inches.

arcrad = 0.25
arrowhead = 2.0
arrowht = 0.08
arrowwid = 0.06
boxht = 0.5
boxrad = 0.0
boxwid = 0.75
charht = 0.14
charwid = 0.08
circlerad = 0.25
color = black
cylht = 0.5
cylrad = 0.075
cylwid = 0.75
dashwid = 0.05
diamondht = 0.75
diamondwid = 1.0
dotrad = 0.015
ellipseht = 0.5
ellipsewid = 0.75
fileht = 0.75
filerad = 0.15
filewid = 0.5
fill = none
lineht = 0.5
linewid = 0.5
movewid = 0.5
ovalht = 0.5
ovalwid = 1.0
scale = 1.0
textht = 0.5
textwid = 0.75
thickness = 0.015

# --- Text sizes (docs/spec.md SS3.3) --------------------------------------
# Three fixed sizes in points, not pikchr's percentage-of-viewer-font
# scaling. `small`/`medium`/`large` are reserved words (they also work as
# text flags, `"Label" large`), assignable exactly like `fill`/`color`/
# `thickness` above.

small = 9pt
medium = 10.5pt
large = 12pt

# --- Font family (docs/spec.md SS3.3) --------------------------------------
# Empty means "the theme's own font": a renderer emits a symbolic reference
# (the theme's minor font, or its major/heading font where the `major` text
# flag is used) rather than a literal family, so the diagram's text follows
# whatever theme the deck actually uses -- this is the point that matters
# for Japanese, since the deck's theme decides the CJK face. Set this
# (typically in a template's settings file, once that exists) to override
# with one specific family for both the Latin and East Asian slots.

typeface = ""
