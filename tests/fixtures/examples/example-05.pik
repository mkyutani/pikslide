    $laneh = 0.75

    # Draw the lanes
    down
    box width 3.5in height $laneh fill 0xacc9e3
    box same fill 0xc5d8ef
    box same as first box
    box same as 2nd box
    line "Alan" above aligned \
      from 1st box.sw+(0.2,0) up until even with 1st box.n
    line "Betty" above aligned \
      from 2nd box.sw+(0.2,0) up until even with 2nd box.n
    line "Charlie" above aligned \
      from 3rd box.sw+(0.2,0) up until even with 3rd box.n
    line "Darlene" above aligned \
      from 4th box.sw+(0.2,0) up until even with 4th box.n

    # fill in content for the Alice lane
    right
A1: circle "1" rad 0.1in at end of first line + (0.2,-0.2) \
       fill white stroke thickness 1.5px
    arrow right 50%
    circle "2" same
    arrow right until even with first box.e - (0.65,0.0)
    ellipse "future" fit fill white height 0.2 width 0.5 stroke thickness 1.5px
A3: circle "3" same at A1+(0.8,-0.3) fill 0xc0c0c0
    arrow "fork!" below from A1 to last circle chop aligned

    # content for the Betty lane
B1: circle "1" same as A1 at A1-(0,$laneh)
    arrow right 50%
    circle "2" same
    arrow right until even with first ellipse.w
    ellipse "future" same
B3: circle "3" same at A3-(0,$laneh)
    arrow right 50%
    circle "4" same as A3
    arrow from B1 to 2nd last circle chop

    # content for the Charlie lane
C1: circle "1" same as A1 at B1-(0,$laneh)
    arrow 50%
    circle "2" same
    arrow "goes" "offline" right 0.8in
C5: circle "5" same as A3
    arrow "back online" above "pushes 5" below "pulls 3 &amp; 4" below \
      right until even with first ellipse.w
    ellipse "future" same

    # content for the Darlene lane
D1: circle "1" same as A1 at C1-(0,$laneh)
    arrow 50%
    circle "2" same
    arrow right until even with C5.w
    circle "5" same
    arrow 50%
    circle "6" same as A3
    arrow right until even with first ellipse.w
    ellipse "future" same
D3: circle "3" same as B3 at B3-(0,2*$laneh)
    arrow 50%
    circle "4" same
    arrow from D1 to D3 chop
